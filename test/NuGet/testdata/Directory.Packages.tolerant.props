<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="normal" Version="1.0.0" />
    <PackageVersion Remove="removed" />
    <PackageVersion Include="attrless" />
    <PackageVersion Include="child.version">
      <Version>2.0.0</Version>
    </PackageVersion>
    <PackageVersion Update="updated" Version="3.0.0" />
  </ItemGroup>
</Project>
